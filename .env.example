# Copy to .env for local development; use a host secret store in production.
SECRET_KEY=replace_with_a_random_64_character_secret
MONGO_URI=mongodb+srv://user:password@cluster.example.mongodb.net/database
GEMINI_API_KEY=replace_with_gemini_api_key
OPENROUTER_API_KEY=replace_with_openrouter_api_key
ASANA_MIND_URL=http://127.0.0.1:5000
PORT=5000
